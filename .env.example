# Copy this file to .env.local and fill in real values.
#   cp .env.example .env.local
# Never commit .env.local or any real keys. All values below are placeholders.

# --- No-login demo mode ---
# The app ships with a read-only demo at /demo that bypasses auth and serves
# mock portfolio fixtures (src/lib/demo/fixtures.ts) — no Supabase or API keys
# needed. Set NEXT_PUBLIC_DEMO_MODE=1 to default EVERY visitor into demo mode
# (e.g. for a public recruiter-facing preview deployment). Leave unset for the
# normal login-gated app, where /demo is still reachable via "View live demo".
# NEXT_PUBLIC_DEMO_MODE=1

# --- Supabase (Postgres + Auth + RLS) ---
# Project URL and anon key are exposed to the browser (NEXT_PUBLIC_*).
# Server code falls back to the non-prefixed vars; the standalone scripts
# (import / invest:brief / verify*) read SUPABASE_URL directly.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
# Service-role key: server-only, bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# --- Charles Schwab (OAuth — Individual Developer app; see docs/SCHWAB_SETUP.md) ---
SCHWAB_APP_KEY=your-schwab-app-key-here
SCHWAB_APP_SECRET=your-schwab-app-secret-here
SCHWAB_CALLBACK_URL=https://your-app-domain/api/schwab/callback
# Optional: map Schwab account hashes to friendly names, e.g. "hash1=Brokerage,hash2=Roth"
SCHWAB_ACCOUNT_NICKNAMES=

# --- Coinbase (CDP API key — Ed25519) ---
COINBASE_API_KEY=your-coinbase-cdp-api-key-here
COINBASE_API_SECRET=your-coinbase-cdp-api-secret-here

# --- Finnhub (market data) ---
FINNHUB_API_KEY=your-finnhub-api-key-here

# --- Gemini (in-app AI assistant) ---
GEMINI_API_KEY=your-gemini-api-key-here

# --- Scripts / verification (CLI only) ---
# Target user for `npm run import` and `npm run invest:brief`.
TARGET_USER_ID=your-target-user-uuid-here
# Credentials the verify scripts use to sign in as a seeded test user.
TEST_USER_EMAIL=your-test-user-email-here
TEST_USER_PASSWORD=your-test-user-password-here

# --- Private, owner-only operation (see docs/CLAUDE_READONLY.md) ---
# Owner auth.users id(s): who the daily cron syncs and who Coinbase may sync into.
OWNER_USER_IDS=
# Vercel Cron bearer secret for /api/cron/sync. Generate a long random string.
CRON_SECRET=
# Optional sign-up allow-list. Leave unset to keep sign-up closed.
ALLOWED_SIGNUP_EMAILS=
