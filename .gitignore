# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but track the placeholder template used for setup
!.env.example

# vercel
.vercel

# financial data (sensitive — keep directory structure via .gitkeep)
/data/raw/**
!/data/raw/**/
!/data/raw/**/.gitkeep
/data/normalized/**
!/data/normalized/
!/data/normalized/.gitkeep
/data/snapshots/**
!/data/snapshots/
!/data/snapshots/.gitkeep
/config/user-profile.json

# typescript
*.tsbuildinfo
next-env.d.ts
